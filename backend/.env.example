# Copy to .env and adjust as needed.

DATABASE_URL=postgresql+psycopg://space_rag:space_rag@localhost:5433/space_rag

# Where raw downloaded PDFs are stored. Local disk for now; swap for S3 later.
RAW_STORAGE_DIR=../data/raw

# NTRS (NASA Technical Reports Server) search API.
NTRS_API_BASE=https://ntrs.nasa.gov/api/citations/search

# Local LLM generation via Ollama. Requires `brew services start ollama`
# and `ollama pull llama3.2:3b` (or your own choice of model/tag).
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
